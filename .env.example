# Copy to backend/.env or project root .env
# OpenAI-compatible endpoint. GPT-4o is the default for plot-image accuracy.
LLM_API_KEY=
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o

# Optional: use a cheaper model for retries
LLM_FAST_MODEL=gpt-4o-mini

# Optional. Default is sqlite at <repo>/data/app.db
# DATABASE_URL=postgresql+psycopg2://user:pass@localhost:5432/fire_agent
CORS_ORIGINS=http://localhost:5173
UPLOAD_DIR=./data/uploads
OUTPUT_DIR=./data/outputs
